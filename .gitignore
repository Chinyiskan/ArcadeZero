# --- Node / frontend ---
.DS_Store
node_modules/
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# --- Rust / Tauri ---
/target/
src-tauri/target/
src-tauri/gen/schemas/

# --- Python / runtime embebido ---
# runtime/dist (build armado) y runtime/.cache (descargas) NO se commitean;
# runtime/launcher.py, runtime/build_runtime.py, runtime/vendored/ y
# runtime/tests/ SI se commitean (ver runtime/.gitignore y PLAN.md §4).
runtime/dist/
runtime/.cache/
__pycache__/
*.pyc

# --- Secrets (por si alguna vez alguien los deja dentro del repo por error;
# la clave del updater vive fuera del repo a proposito, ver PLAN.md §11) ---
*.key
*.pem
secrets/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
Thumbs.db

# --- Notas internas de desarrollo (no son parte del producto ni utiles
# para quien clona el repo para usarlo o contribuir) ---
/.claude/
/PLAN.md
