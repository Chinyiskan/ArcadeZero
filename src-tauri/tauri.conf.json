{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcadeZero",
  "version": "0.1.3",
  "identifier": "org.arcadezero.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ArcadeZero",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/dist/windows-x64/": "runtime/",
      "../templates/": "templates/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzQUM3NEY2MzA0NzcyMTYKUldRV2NrY3c5blNzNDE4S1ZxVlBRRW0wcTU0eHBPSW5OblZnemNNeDBTY05VemJoVWt4bEFzWWkK",
      "endpoints": [
        "https://github.com/Chinyiskan/ArcadeZero/releases/latest/download/latest.json"
      ]
    }
  }
}
